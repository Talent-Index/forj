# Deployer private key (never commit real keys). Never prefix this with VITE_.
PRIVATE_KEY=
FUJI_RPC_URL=https://avalanche-fuji-c-chain.publicnode.com
# C-Chain RPC for Hardhat's avalanche network. Must not be a Fuji URL. Never prefix with VITE_.
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# After deploying to Avalanche Fuji (npm run deploy:fuji), paste contract address here
# or let deploy.js update this automatically
VITE_CREDENTIAL_CONTRACT=

# Stable IPFS or HTTPS artwork URL written into CredentialData.image.
# Local Vite assets are not usable on Snowtrace. Empty is allowed on-chain.
VITE_CREDENTIAL_IMAGE_URI=

# Optional public Fuji RPC for credential lookup (HTTPS only; defaults to publicnode)
VITE_FUJI_RPC_URL=https://avalanche-fuji-c-chain.publicnode.com

# Optional. First block to scan for CredentialMinted logs (transaction hash on lookup)
VITE_CREDENTIAL_DEPLOY_BLOCK=

# Optional. Pinata JWT for `npm run metadata:upload` — never commit a real token.
# Never prefix this with VITE_.
PINATA_JWT=

# Optional Google Identity client ID for "Continue with Google".
# Leave empty to use the local Google continuation in this frontend-only app.
VITE_GOOGLE_CLIENT_ID=

# Firebase web app config is public client configuration (restricted by authorized
# domains and security rules). Override only if the project changes.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# Optional Firebase App Check (reCAPTCHA v3 site key — public client config).
# Register the web app in Firebase Console → App Check, then set the site key.
# Enforce App Check for Auth/Firestore/Storage in the console after this is live.
# VITE_FIREBASE_APPCHECK_SITE_KEY=

# Optional: copy to .env.local for machine-specific overrides.
# Only non-empty values in .env.local override .env (Hardhat + Vite).
