# Deployer private key (never commit real keys)
PRIVATE_KEY=
FUJI_RPC_URL=https://avalanche-fuji-c-chain.publicnode.com

# After deploying to Avalanche Fuji (npm run deploy:fuji), paste contract address here
# or let deploy.js update this automatically
VITE_CREDENTIAL_CONTRACT=

# Stable IPFS or HTTPS artwork URL written into CredentialData.image.
# Local Vite assets are not usable on Snowtrace. Empty is allowed on-chain.
VITE_CREDENTIAL_IMAGE_URI=

# Optional public Fuji RPC for credential lookup (defaults to publicnode)
VITE_FUJI_RPC_URL=https://avalanche-fuji-c-chain.publicnode.com

# Optional. First block to scan for CredentialMinted logs (transaction hash on lookup)
VITE_CREDENTIAL_DEPLOY_BLOCK=

# Optional. Pinata JWT for `npm run metadata:upload` — never commit a real token.
PINATA_JWT=

# Optional Google Identity client ID for "Continue with Google".
# Leave empty to use the local Google continuation in this frontend-only app.
VITE_GOOGLE_CLIENT_ID=

# Optional: copy to .env.local for machine-specific overrides.
# Only non-empty values in .env.local override .env (Hardhat + Vite).
